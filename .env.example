# Copy this file to `.env` in the same folder and fill in the value.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# This file (.env.example) is committed on purpose — it documents which
# variables exist, without their values.

# Xeno-canto API v3 key.
# Get one at https://xeno-canto.org after registering and verifying your email,
# then find it on your account page. Create an app key, not a personal key.
#
# Used only by the build-time catalog script (scripts/fetch-catalog.mjs).
# It is deliberately NOT prefixed with VITE_ — that prefix would ship the
# value to the browser, where anyone could read it.
XENO_CANTO_KEY=
